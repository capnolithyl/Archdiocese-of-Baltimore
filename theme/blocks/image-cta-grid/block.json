{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "balt/image-cta-grid",
  "version": "1.0.0",
  "title": "Image CTA Grid",
  "category": "baltimore",
  "icon": "images-alt2",
  "description": "Four linked image cards with an overlapping, editable content panel.",
  "keywords": [
    "image cards",
    "image grid",
    "cta",
    "overlapping panel",
    "links"
  ],
  "textdomain": "baltimore",
  "acf": {
    "mode": "preview",
    "renderCallback": "balt_render_image_cta_grid_block",
    "blockVersion": 3
  },
  "supports": {
    "anchor": true,
    "align": [
      "full"
    ],
    "html": false
  },
  "attributes": {
    "align": {
      "type": "string",
      "default": "full"
    }
  }
}
