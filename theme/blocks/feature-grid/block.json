{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "balt/feature-grid",
  "version": "1.1.0",
  "title": "Navigate / Feature Grid",
  "category": "baltimore",
  "icon": "screenoptions",
  "description": "One to twelve linked feature cards in classic or compact styles.",
  "keywords": [
    "navigate",
    "explore",
    "feature grid",
    "icon links",
    "featured links",
    "resources",
    "downloads"
  ],
  "textdomain": "baltimore",
  "acf": {
    "mode": "preview",
    "renderCallback": "balt_render_feature_grid_block",
    "blockVersion": 3
  },
  "supports": {
    "anchor": true,
    "align": [
      "full"
    ],
    "html": false
  },
  "attributes": {
    "align": {
      "type": "string",
      "default": "full"
    }
  }
}
