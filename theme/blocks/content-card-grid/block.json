{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "balt/content-card-grid",
  "version": "1.1.0",
  "title": "Content Card Grid",
  "category": "baltimore",
  "icon": "grid-view",
  "description": "Reusable manual, selected or latest content cards, with an optional directory layout and local card filtering.",
  "keywords": [
    "cards",
    "offices",
    "ministries",
    "posts",
    "grid"
  ],
  "textdomain": "baltimore",
  "acf": {
    "mode": "preview",
    "renderCallback": "balt_render_content_card_grid_block",
    "blockVersion": 3
  },
  "supports": {
    "anchor": true,
    "align": [
      "full"
    ],
    "html": false
  },
  "attributes": {
    "align": {
      "type": "string",
      "default": "full"
    }
  }
}
