{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "dpi/feature-banner",
  "version": "1.3.0",
  "title": "Featured Content Slider",
  "category": "baltimore",
  "icon": "align-wide",
  "description": "One to five full-width featured image slides with eyebrow, heading, subheading, two CTAs and Slick navigation.",
  "keywords": [
    "featured",
    "slider",
    "banner",
    "cta"
  ],
  "textdomain": "baltimore",
  "acf": {
    "mode": "preview",
    "renderCallback": "balt_render_ported_dpi_block",
    "blockVersion": 3
  },
  "supports": {
    "anchor": true,
    "align": [
      "full"
    ],
    "html": false
  },
  "style": [
    "balt-ported-dpi-slick"
  ],
  "script": "balt-ported-dpi-interactions",
  "attributes": {
    "align": {
      "type": "string",
      "default": "full"
    }
  }
}
