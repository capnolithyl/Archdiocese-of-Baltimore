{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "dpi/hero",
  "version": "1.5.0",
  "title": "Hero",
  "category": "baltimore",
  "icon": "cover-image",
  "description": "Full-width video hero with a heading, subheading and up to two buttons, or an image carousel.",
  "keywords": [
    "hero",
    "banner",
    "slider",
    "video"
  ],
  "textdomain": "baltimore",
  "acf": {
    "mode": "preview",
    "renderCallback": "balt_render_ported_dpi_block",
    "blockVersion": 3
  },
  "supports": {
    "anchor": true,
    "align": [
      "full"
    ],
    "html": false
  },
  "style": [
    "balt-ported-dpi-defaults",
    "balt-ported-dpi-slick"
  ],
  "script": "balt-ported-dpi-interactions",
  "attributes": {
    "align": {
      "type": "string",
      "default": "full"
    }
  }
}
