{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "dpi/hero",
  "version": "1.4.0",
  "title": "Hero",
  "category": "baltimore",
  "icon": "cover-image",
  "description": "A configurable image-slider or video hero with calls to action.",
  "keywords": [
    "hero",
    "banner",
    "slider",
    "video"
  ],
  "textdomain": "baltimore",
  "acf": {
    "mode": "preview",
    "renderCallback": "balt_render_ported_dpi_block",
    "blockVersion": 3
  },
  "supports": {
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "color": {
      "background": true,
      "text": true,
      "link": true,
      "gradients": true
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    },
    "dimensions": {
      "minHeight": true
    },
    "html": false
  },
  "style": [
    "balt-ported-dpi-defaults",
    "balt-ported-dpi-slick"
  ],
  "script": "balt-ported-dpi-interactions"
}
