{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"palette": [
				{
				"slug": "primary",
				"color": "#002D62",
				"name": "Primary"
				},
				{
				"slug": "secondary",
				"color": "#C9A840",
				"name": "Secondary"
				},
				{
				"slug": "tertiary",
				"color": "#BE2026",
				"name": "Tertiary"
				},
				{
				"slug": "foreground",
				"color": "#0F1A2E",
				"name": "Foreground"
				},
				{
				"slug": "body",
				"color": "#4A5565",
				"name": "Body"
				},
				{
				"slug": "muted",
				"color": "#6B6B7B",
				"name": "Muted"
				},
				{
				"slug": "background",
				"color": "#F5F3EE",
				"name": "Background"
				},
				{
				"slug": "surface",
				"color": "#F0EDE8",
				"name": "Surface"
				},
				{
				"slug": "white",
				"color": "#FFFFFF",
				"name": "White"
				}
			]
			},
		"layout": {
			"compactSize": "520px",
			"smallSize": "600px",
			"narrowSize": "700px",
			"editorialSize": "860px",
			"contentSize": "900px",
			"wideSize": "1504px"
		},
		"typography": {
			"fontFamilies": [
				{
					"name": "Body",
					"slug": "body",
					"fontFamily": "\"Lato\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Lato",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/Lato/Lato-Regular.ttf"
							]
						},
						{
							"fontFamily": "Lato",
							"fontStyle": "italic",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/Lato/Lato-Italic.ttf"
							]
						},
						{
							"fontFamily": "Lato",
							"fontStyle": "normal",
							"fontWeight": "700",
							"src": [
								"file:./assets/fonts/Lato/Lato-Bold.ttf"
							]
						},
						{
							"fontFamily": "Lato",
							"fontStyle": "italic",
							"fontWeight": "700",
							"src": [
								"file:./assets/fonts/Lato/Lato-BoldItalic.ttf"
							]
						}
					]
				},
				{
					"name": "Heading",
					"slug": "heading",
					"fontFamily": "\"EB Garamond\", Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "EB Garamond",
							"fontStyle": "normal",
							"fontWeight": "400 800",
							"src": [
								"file:./assets/fonts/EB_Garamond/EBGaramond-VariableFont_wght.ttf"
							]
						},
						{
							"fontFamily": "EB Garamond",
							"fontStyle": "italic",
							"fontWeight": "400 800",
							"src": [
								"file:./assets/fonts/EB_Garamond/EBGaramond-Italic-VariableFont_wght.ttf"
							]
						}
					]
				}
			]
		}
	}
}
