# Ignore dependencies from npm and Composer:
/node_modules
/vendor

# Ignore generated JavaScript files:
*.min.js

# Ignore generated CSS files:
style.css
style-editor.css
style-editor-extra.css
tailwind-intellisense.css

# Ignore the generated zip file:
baltimore.zip

# Ignore local VS Code settings, including SFTP credentials:
/.vscode/

# Ignore .DS_Store files from macOS:
.DS_Store

# Local environment files and secrets:
.env
.env.*
!.env.example
*.pem
*.key

# Other editor/project settings:
.idea/
